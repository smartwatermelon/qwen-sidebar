{
  "manifest_version": 3,
  "name": "Qwen Sidebar",
  "version": "2.0.0",
  "description": "Chat with Qwen models in a side panel, optionally using the current page as context.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Open Qwen Sidebar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
